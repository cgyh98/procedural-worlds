# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Obsidian (keep settings, ignore per-device UI state)
vault/.obsidian/workspace*.json
vault/.obsidian/cache
vault/.trash/

# Env / secrets
.env
.env.*
!.env.example

# Firebase CLI cache
.firebase/
firebase-debug.log

# Vault images stay local: progress screenshots and reference images by other artists
# (inspiration boards, UI references). The Obsidian notes still show them on this machine.
vault/assets/*
!vault/assets/.gitkeep
